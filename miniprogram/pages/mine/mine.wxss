.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

/* 车型分组卡片 */
.group-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.group-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 1rpx;
}
.group-count {
  font-size: 24rpx;
  color: #8e8e93;
}

/* 作品网格：一行两张（百分比宽度 + space-between，兼容 calc 失效场景） */
.skin-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.skin-card {
  width: 48.5%;
  margin-bottom: 16rpx;
  background: #fafafa;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #f0f0f0;
}

/* 整车长图等比完整展示 */
.skin-thumb {
  width: 100%;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.skin-img {
  width: 100%;
  height: 100%;
}

.skin-title {
  padding: 12rpx 16rpx 4rpx;
  font-size: 24rpx;
  color: #1a1a1a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 操作按钮 */
.skin-ops {
  display: flex;
  padding: 8rpx 16rpx 16rpx;
}
.op-btn + .op-btn {
  margin-left: 12rpx;
}
.op-btn {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #1a1a1a;
  background: #f0f0f2;
  border-radius: 28rpx;
  padding: 8rpx 0;
  white-space: nowrap;
}
.op-copy {
  color: #1a1a1a;
  background: #e8e8ec;
}

/* 棋盘格背景：衬托透明 PNG 整车图 */
.checkerboard {
  background-image:
    linear-gradient(45deg, #e8e8ea 25%, transparent 25%, transparent 75%, #e8e8ea 75%),
    linear-gradient(45deg, #e8e8ea 25%, transparent 25%, transparent 75%, #e8e8ea 75%);
  background-color: #f5f5f7;
  background-size: 24rpx 24rpx;
  background-position: 0 0, 12rpx 12rpx;
}

.tip {
  text-align: center;
  font-size: 24rpx;
  color: #8e8e93;
  padding: 16rpx 0;
}

/* 空态 */
.empty {
  text-align: center;
  padding: 160rpx 0 40rpx;
  color: #8e8e93;
  font-size: 28rpx;
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

/* 开始创作按钮 */
.start-create {
  padding: 32rpx 0 60rpx;
}
.start-create-btn {
  width: 100%;
  font-size: 32rpx;
  background: #1a1a1a;
  color: #fff;
  border-radius: 100rpx;
}
.start-create-btn::after {
  border: none;
}
