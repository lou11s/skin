/* 创作页：灰底 + 白卡分步，与「我的作品」页同一套视觉语言 */
.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
/* 调整模式：保存栏已隐藏，收窄底部预留，编辑器与旋转面板获得完整空间 */
.page-adj {
  padding-bottom: 60rpx;
}

/* ---------- 顶部导航（吸顶） ---------- */
.nav {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f5f5f7;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}
.nav-back {
  width: 140rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 44rpx;
  color: #1a1a1a;
  background: #ffffff;
  border-radius: 100rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #1a1a1a;
}
.nav-act {
  width: 140rpx;
  text-align: right;
  font-size: 26rpx;
  color: #8e8e93;
}
.nav-act-ph {
  color: transparent;
}

/* ---------- 修改模式提示条 ---------- */
.edit-tip {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 16rpx 22rpx;
  border-radius: 16rpx;
  background: #fff7e6;
  border: 1rpx solid #ffe0a3;
}
.edit-tip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fa8c16;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.edit-tip-txt {
  font-size: 24rpx;
  color: #ad6800;
  line-height: 1.5;
}

/* ---------- 卡片与步骤头 ---------- */
.card {
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.card-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.step-no {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #1a1a1a;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.step-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 1rpx;
}
.step-side {
  font-size: 24rpx;
  color: #8e8e93;
  max-width: 280rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.head-link {
  font-size: 26rpx;
  color: #1a1a1a;
  background: #f0f0f2;
  border-radius: 100rpx;
  padding: 8rpx 22rpx;
  flex-shrink: 0;
}
.card-desc {
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.7;
}

.loading {
  padding: 48rpx 0;
  text-align: center;
  color: #8e8e93;
  font-size: 26rpx;
}
.empty {
  padding: 48rpx 0;
  text-align: center;
  color: #8e8e93;
  font-size: 26rpx;
}

/* ---------- 车型选择：横向滚动芯片 ---------- */
.model-strip {
  width: 100%;
  white-space: nowrap;
}
.model-chip {
  flex: none;
  display: inline-block;
  padding: 18rpx 30rpx;
  margin-right: 16rpx;
  background: #f5f5f7;
  border-radius: 100rpx;
  font-size: 26rpx;
  color: #3a3a3c;
}
.model-chip.on {
  background: #1a1a1a;
  color: #ffffff;
  font-weight: 500;
}

/* ---------- 进度条 ---------- */
.progress {
  height: 8rpx;
  background: #ececef;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.progress-in {
  height: 100%;
  background: #1a1a1a;
  border-radius: 4rpx;
  transition: width 0.3s;
}

/* ---------- 整车预览 ---------- */
.overview-box {
  position: relative;
  padding: 16rpx;
  border-radius: 20rpx;
  background-color: #fafafa;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.overview-canvas {
  width: 560rpx;
  height: 560rpx;
}
.overview-toggle {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 8rpx 22rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  color: #1a1a1a;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}
.overview-toggle.on {
  color: #ffffff;
  background: #1a1a1a;
  border-color: #1a1a1a;
}
.legend {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #8e8e93;
  text-align: center;
  line-height: 1.6;
}

/* ---------- 当前面编辑器 ---------- */
.face-editor {
  position: relative;
  margin-top: 20rpx;
  height: 620rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: #fafafa;
  border: 1rpx solid #ececef;
  box-sizing: border-box;
}
.face-canvas {
  width: 100%;
  height: 620rpx;
}
.editor-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 16rpx;
  text-align: center;
  font-size: 23rpx;
  color: #ffffff;
  background: rgba(26, 26, 26, 0.6);
}

/* ---------- 图层条 ---------- */
.layer-wrap {
  margin-top: 20rpx;
}
.layer-bar {
  width: 100%;
  white-space: nowrap;
}
.layer-chip {
  position: relative;
  display: inline-block;
  width: 88rpx;
  height: 88rpx;
  margin-right: 14rpx;
  border: 3rpx solid transparent;
  border-radius: 14rpx;
  background: #f2f2f4;
  overflow: hidden;
  box-sizing: border-box;
}
.layer-chip.active {
  border-color: #1a1a1a;
  background: #ffffff;
}
.layer-thumb {
  width: 100%;
  height: 100%;
}
.layer-add {
  background: #ffffff;
  border: 3rpx dashed #c8c8cd;
  color: #8e8e93;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 82rpx;
  text-align: center;
}
.layer-hint {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #b0b0b5;
}

/* ---------- 编辑操作按钮 ---------- */
.tool-row {
  display: flex;
  margin-top: 20rpx;
}
.tool-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #1a1a1a;
  background: #f5f5f7;
  border-radius: 16rpx;
  white-space: nowrap;
}
.tool-btn + .tool-btn {
  margin-left: 16rpx;
}
.adjust-toggle {
  margin-top: 16rpx;
  text-align: center;
  padding: 22rpx 0;
  font-size: 27rpx;
  font-weight: 500;
  color: #1a1a1a;
  background: #ffffff;
  border: 2rpx solid #1a1a1a;
  border-radius: 100rpx;
  box-sizing: border-box;
}
.adjust-toggle.on {
  background: #1a1a1a;
  color: #ffffff;
}

/* ---------- 旋转控制面板 ---------- */
.adjust-panel {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 20rpx;
}
.adjust-row {
  display: flex;
}
.adjust-row + .adjust-row {
  margin-top: 14rpx;
}
.adjust-btn {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  font-size: 25rpx;
  background: #ffffff;
  border-radius: 14rpx;
  color: #1a1a1a;
  white-space: nowrap;
}
.adjust-btn + .adjust-btn {
  margin-left: 14rpx;
}
.adjust-btn.adjust-go {
  flex: none;
  width: 180rpx;
  background: #1a1a1a;
  color: #ffffff;
}
.adjust-input {
  flex: 1;
  padding: 18rpx 24rpx;
  font-size: 25rpx;
  background: #ffffff;
  border-radius: 14rpx;
  box-sizing: border-box;
}
.adjust-input + .adjust-btn {
  margin-left: 14rpx;
}
.adjust-tip {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #b0b0b5;
  text-align: center;
}

/* ---------- 背景填充 ---------- */
.bg-cur-row {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fafafa;
  border-radius: 16rpx;
}
.bg-cur-label {
  font-size: 24rpx;
  color: #8e8e93;
}
.bg-cur-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #dcdce0;
  box-sizing: border-box;
  margin: 0 12rpx 0 20rpx;
}
.bg-cur-val {
  flex: 1;
  font-size: 24rpx;
  color: #1a1a1a;
  font-weight: 500;
}
.swatch-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.swatch {
  width: 56rpx;
  height: 56rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 50%;
  border: 4rpx solid transparent;
  box-sizing: border-box;
  box-shadow: inset 0 0 0 2rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.swatch.active {
  border-color: #1a1a1a;
  box-shadow: inset 0 0 0 4rpx #ffffff;
}
.swatch-none {
  background: #ededf0;
}
.swatch-none-txt {
  font-size: 20rpx;
  color: #8e8e93;
}
/* 取色滑条：横向拖动取色。色相条渐变固定，饱和度/明度条渐变由 JS 内联下发 */
.color-bar {
  height: 36rpx;
  margin-top: 14rpx;
  border-radius: 18rpx;
  box-shadow: inset 0 0 0 2rpx rgba(0, 0, 0, 0.08);
}
.hue-bar {
  background: linear-gradient(to right, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000);
}
.bg-code-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.bg-code-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fafafa;
  border: 1rpx solid #ececef;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #1a1a1a;
  box-sizing: border-box;
}
.bg-code-apply {
  margin-left: 16rpx;
  padding: 16rpx 34rpx;
  background: #1a1a1a;
  color: #ffffff;
  border-radius: 100rpx;
  font-size: 25rpx;
}

/* ---------- 命名 ---------- */
.title-box {
  background: #fafafa;
  border: 1rpx solid #ececef;
  border-radius: 16rpx;
}
.title-input {
  padding: 24rpx;
  font-size: 29rpx;
  color: #1a1a1a;
}
.title-ph {
  color: #c7c7cc;
}

/* ---------- 底部常驻保存栏 ---------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 25;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}
.bb-info {
  flex: 1;
  font-size: 23rpx;
  color: #8e8e93;
  line-height: 1.4;
  padding-right: 16rpx;
}
.bb-btn {
  flex-shrink: 0;
  width: 280rpx;
  margin: 0;
  padding: 0;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 29rpx;
  font-weight: 500;
  color: #ffffff;
  background: #1a1a1a;
  border-radius: 100rpx;
}
.bb-btn::after {
  border: none;
}
.bb-btn[disabled] {
  background: #d8d8d8;
  color: #ffffff;
}

/* ---------- 抠图素材选择弹层 ---------- */
.pick-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 29;
}
.pick-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  max-height: 70vh;
}
.pick-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.pick-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.pick-close {
  padding: 8rpx 20rpx;
  font-size: 30rpx;
  color: #8e8e93;
}
.pick-body {
  flex: 1;
  max-height: 52vh;
  overflow: hidden;
}
.pick-empty {
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pick-empty-txt {
  font-size: 27rpx;
  font-weight: 500;
  color: #3a3a3c;
}
.pick-empty-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #8e8e93;
}
.pick-foot {
  margin-top: 18rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b0b5;
}
/* 弹层内素材网格：每行 3 个 */
.cut-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.cut-cell {
  position: relative;
  width: 31%;
  height: 200rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #ececef;
  border-radius: 18rpx;
  overflow: hidden;
  box-sizing: border-box;
}
/* 占位：末行不足 3 个时补位，保证素材靠左对齐（高度 0 不可见） */
.cut-ph {
  width: 31%;
  height: 0;
}
.cut-img {
  width: 100%;
  height: 100%;
}
.cut-tag {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 4rpx 0;
  text-align: center;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.45);
}

/* 离屏画布：移出可视区，仅用于合成 */
.offscreen {
  position: fixed;
  left: -9999px;
  top: -9999px;
}
