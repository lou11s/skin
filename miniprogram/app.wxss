/* 全局样式 - 极简白色风格（参考 ph0t0L） */
page {
  background: #ffffff;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, sans-serif;
  color: #1a1a1a;
  font-size: 28rpx;
}

.container {
  padding: 0;
  box-sizing: border-box;
  min-height: 100vh;
  background: #ffffff;
}

/* 通用卡片：浅灰扁平圆角 */
.card {
  background: #f8f8f8;
  border-radius: 24rpx;
  overflow: hidden;
}

/* 主按钮：黑底白字胶囊 */
.btn-primary {
  background: #1a1a1a;
  color: #ffffff;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.btn-primary[disabled] {
  background: #d8d8d8;
  color: #ffffff;
}

/* 次要按钮：浅灰底胶囊 */
.btn-plain {
  background: #f0f0f0;
  color: #1a1a1a;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

/* 透明 PNG 展示的浅色棋盘格背景 */
.checkerboard {
  background-image:
    linear-gradient(45deg, #f0f0f0 25%, transparent 25%),
    linear-gradient(-45deg, #f0f0f0 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #f0f0f0 75%),
    linear-gradient(-45deg, transparent 75%, #f0f0f0 75%);
  background-size: 32rpx 32rpx;
  background-position: 0 0, 0 16rpx, 16rpx -16rpx, -16rpx 0;
  background-color: #ffffff;
}

/* 区块标题 */
.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 1rpx;
}

/* 小标签：浅灰芯片 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  color: #8e8e93;
  background: #f0f0f0;
  border-radius: 8rpx;
}

/* 辅助文字 */
.muted {
  color: #8e8e93;
}

/* 空态 */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #8e8e93;
  font-size: 28rpx;
}
.empty .empty-icon {
  font-size: 88rpx;
  margin-bottom: 24rpx;
}
